<?xml version="1.0" ?>
<!-- Arşivdeki havuz ve araç gövdesi. Yatay itki gövdeye net kuvvet olarak uygulanır. -->
<sdf version="1.8">
  <world name="pool">
    <physics name="adim" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="ignition-gazebo-apply-link-wrench-system" name="ignition::gazebo::systems::ApplyLinkWrench"/>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
